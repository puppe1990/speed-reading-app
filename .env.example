# TURSO_DATABASE_URL: em produção, a URL do banco Turso (libsql://...).
# Localmente, deixe vazio para usar o SQLite em src/data/leitor.db.
TURSO_DATABASE_URL=""

# TURSO_AUTH_TOKEN: token de acesso ao banco Turso (produção).
TURSO_AUTH_TOKEN=""

# SESSION_SECRET: segredo para assinar o cookie de sessão. Obrigatório em produção.
SESSION_SECRET="dev-secret-change-me"

# PORT: porta do servidor local.
PORT="4173"
