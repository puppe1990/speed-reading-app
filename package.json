{
  "name": "speed-reader-immersive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Leitor Dinâmico Imersivo: HTMX + Tailwind + HTML SSR + Turso (libSQL).",
  "scripts": {
    "dev": "node src/server.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run lint && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,html,md,toml,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
